# Postgres connection string. Use the POOLED url from Neon / Vercel Postgres.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# The household timezone. All week and month maths uses this, never the server's.
APP_TIMEZONE="Africa/Johannesburg"

# Public URL of the deployment, used in invite and reset emails.
APP_URL="https://dashboard.example.com"
